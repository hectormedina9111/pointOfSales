# Copiar a .env para uso local. Contiene solo valores de desarrollo; nunca usar en producción.
POS_DB_USER=pos
POS_DB_PASSWORD=pos

# Clave para firmar los JWT; al menos 32 caracteres. Valor de desarrollo.
POS_JWT_SECRET=dev-only-change-me-0123456789abcdefghij

# Contraseña inicial del usuario "admin" (solo central). Si se deja vacía, se genera
# al primer arranque y se muestra una sola vez en el log. Se pide cambiarla al ingresar.
POS_ADMIN_INITIAL_PASSWORD=
