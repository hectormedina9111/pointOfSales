# Copiar a .env para uso local. Contiene solo valores de desarrollo; nunca usar en producción.
POS_DB_USER=pos
POS_DB_PASSWORD=pos

# Clave para firmar los JWT; al menos 32 caracteres. Valor de desarrollo.
POS_JWT_SECRET=dev-only-change-me-0123456789abcdefghij

# Contraseña inicial del usuario "admin" (solo central), SOLO PARA EL ENTORNO LOCAL.
# Vagrant copia este archivo a .env si no existe, así que en local el admin entra con
# esta contraseña y el sistema obliga a cambiarla en el primer ingreso.
# En producción no se usa este archivo: la variable se define como secreto del servidor
# o se deja vacía, y entonces se genera al primer arranque y se muestra una sola vez en el log.
POS_ADMIN_INITIAL_PASSWORD=Admin.Local.2026

# Códigos de activación de desarrollo, SOLO LOCAL. Central: "numeroTienda:codigo", separados por coma.
# Al arrancar, la central prepara esos códigos y cada tienda local se activa sola.
POS_DEV_ACTIVATION_CODES=1:STORE1-DEV-CODE,2:STORE2-DEV-CODE
# Código de activación de cada tienda local (valores de desarrollo). En producción se genera en la central
# (POST /api/v1/store-nodes/{id}/activation-code) y se configura en el servidor de la tienda.
POS_STORE1_ACTIVATION_CODE=STORE1-DEV-CODE
POS_STORE2_ACTIVATION_CODE=STORE2-DEV-CODE
